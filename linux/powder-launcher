#!/usr/bin/env bash
# powder-launcher: open the Powder launcher on Linux. With no arguments it opens the GTK4/Libadwaita GUI;
# any arguments pass straight through to the launcher's command line (show, list-mods, enable-mod, launch, ...).
#
# The launcher is the Python package in linux/launcher, run as `python -m launcher` with linux/ on PYTHONPATH.
# It picks which server to run (python | rust), whether to inject the in-game overlay, the Steep folder and the
# game command, which server mods are enabled, and the list of Powder servers; it launches Steep through
# linux/powder-wrap (this wrapper is the window around that one). The admin / overlay Server tab needs the
# Rust server (POWDER_SERVER=rust).
#
#   Desktop entry:  linux/powder-launcher.desktop  (edit its Exec= to this file's absolute path)
#   By hand:        linux/powder-launcher                 # the GUI
#                   linux/powder-launcher list-mods       # the CLI
#
# The launcher needs only the standard library (CLI) plus PyGObject/GTK4/Libadwaita (GUI). PyGObject usually
# lives in the system python3, not in the repo's .venv, so for the GUI we pick the first interpreter that can
# actually import gi; the CLI runs under any Python 3.
set -euo pipefail

SELF=$(readlink -f "$0")
REPO=$(cd "$(dirname "$SELF")/.." && pwd)
export PYTHONPATH="$REPO/linux${PYTHONPATH:+:$PYTHONPATH}"

die() { printf 'powder-launcher: %s\n' "$*" >&2; exit 1; }

# candidate interpreters, in order of preference
candidates=()
[ -x "$REPO/.venv/bin/python" ] && candidates+=("$REPO/.venv/bin/python")
command -v python3 >/dev/null && candidates+=("$(command -v python3)")

PY=""
if [ $# -eq 0 ]; then
    # GUI: the first candidate that can import gi (PyGObject + GTK4 + Libadwaita)
    for p in "${candidates[@]}"; do
        if "$p" -c 'import gi; gi.require_version("Gtk","4.0"); gi.require_version("Adw","1")' 2>/dev/null; then
            PY="$p"; break
        fi
    done
    [ -n "$PY" ] || die "the GUI needs PyGObject (python-gobject) with GTK 4 and Libadwaita (gtk4, libadwaita);
        install those (e.g. on Arch: pacman -S python-gobject gtk4 libadwaita), or use the CLI: $SELF list-mods"
else
    # CLI: any Python 3 (standard library only)
    [ "${#candidates[@]}" -gt 0 ] && PY="${candidates[0]}"
    [ -n "$PY" ] || die "no Python 3 found (install Python 3, or run 'uv sync' in $REPO)"
fi

exec "$PY" -m launcher "$@"
